{
  "name": "cf-access",
  "version": "0.1.0",
  "description": "Cloudflare Access browser login for Node.js",
  "type": "module",
  "private": true,
  "bin": {
    "cf-access": "bin/cf-access.js"
  },
  "scripts": {
    "cf-access": "tsx packages/cli/src/index.ts",
    "dev": "tsx packages/cli/src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/cli/tests/*.test.ts",
    "vendor:keychain": "bash scripts/vendor-cross-keychain.sh",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "commander": "^14.0.0",
    "esbuild": "^0.28.2",
    "jose": "^6.1.0",
    "tsx": "^4.20.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0",
  "files": [
    "bin/",
    "vendor/cross-keychain/LICENSE",
    "docs/cross-keychain.md",
    "README.md"
  ]
}
